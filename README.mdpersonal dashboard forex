
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Kipfx</title><style>body{background:#0f1216;color:#fff;font-family:Arial;margin:0;padding:10px}h1{color:#00ff88;text-align:center}.card{background:#1a1f28;border-radius:12px;padding:12px;margin:14px 0;border:1px solid #2a3441}input,button{width:100%;padding:12px;margin:6px 0;border-radius:8px;border:none;box-sizing:border-box}button{background:#00ff88;color:#000;font-weight:bold}table{width:100%;font-size:13px}th{color:#00ff88;text-align:left}</style></head><body><h1>Kipfx</h1><p style="text-align:center;opacity:.6">Personal Forex Dashboard</p><div class="card"><h3>📈 Live Chart XAUUSD</h3><div style="height:420px"><iframe src="https://s.tradingview.com/widgetembed/?frameElementId=tv&symbol=OANDA%3AXAUUSD&interval=15&theme=dark&timezone=Africa%2FNairobi" style="width:100%;height:100%;border:0"></iframe></div></div><div class="card"><h3>💰 Lot Calculator</h3>Balance $<input id="bal" type="number" value="100">Risk %<input id="risk" type="number" value="2">SL pips<input id="sl" type="number" value="20"><button onclick="calc()">Calculate</button><h2 id="result">Lot: 0.00</h2></div><div class="card"><h3>📓 Journal</h3><input id="pair" placeholder="Pair e.g XAUUSD"><input id="entry" placeholder="BUY 2640 +20pips"><button onclick="addTrade()">Add Trade</button><table id="journal"><tr><th>Pair</th><th>Trade</th></tr></table></div><script>function calc(){let b=document.getElementById('bal').value,r=document.getElementById('risk').value,s=document.getElementById('sl').value;let lot=(b*(r/100))/(s*10);document.getElementById('result').innerText="Lot: "+lot.toFixed(2)}function addTrade(){let p=document.getElementById('pair').value,e=document.getElementById('entry').value;if(!p||!e)return;let row=document.getElementById('journal').insertRow();row.insertCell(0).innerText=p;row.insertCell(1).innerText=e;localStorage.setItem('kipfx',document.getElementById('journal').innerHTML)}window.onload=()=>{let d=localStorage.getItem('kipfx');if(d)document.getElementById('journal').innerHTML=d}</script></body></html>
